{
  "version": 8,
  "sources": {
    "openfreemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "terrain-source": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256
    }
  },
  "terrain": {
    "source": "terrain-source",
    "exaggeration": 1.2
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "landcover-forest",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#aed2a4",
        "fill-opacity": 0.8
      }
    }
    // (Di sini biasanya diisi lapisan jalan, air, dan teks yang panjang.
    // Jika Anda memakai URL style bawaan OpenFreeMap, lapisan ini sudah otomatis ada).
  ]
}
