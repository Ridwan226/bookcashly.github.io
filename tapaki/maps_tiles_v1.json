{
  "version": 8,
  "sources": {
    "opentopomap": {
      "type": "raster",
      "tiles": [
        "https://tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© OpenTopoMap (CC-BY-SA)"
    },
    "hiking": {
      "type": "raster",
      "tiles": [
        "https://tile.waymarkedtrails.org/hiking/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "© Waymarked Trails"
    },
    "terrain-source": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256
    }
  },
  "terrain": {
    "source": "terrain-source",
    "exaggeration": 1.5
  },
  "layers": [
    {
      "id": "opentopomap-layer",
      "type": "raster",
      "source": "opentopomap",
      "paint": {
        "raster-opacity": 1.0
      }
    },
    {
      "id": "3d-hillshade",
      "type": "hillshade",
      "source": "terrain-source",
      "paint": {
        "hillshade-exaggeration": 0.8,
        "hillshade-shadow-color": "#333333",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-illumination-direction": 335
      }
    },
    {
      "id": "hiking-layer",
      "type": "raster",
      "source": "hiking",
      "paint": {
        "raster-opacity": 0.85
      }
    }
  ]
}
