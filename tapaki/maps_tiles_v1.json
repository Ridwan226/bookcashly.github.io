{
  "version": 8,
  "sources": {
    "opentopomap": {
      "type": "raster",
      "tiles": [
        "https://tile.opentopomap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "<a href=\"https://opentopomap.org\">© OpenTopoMap</a>"
    },
    "hiking": {
      "type": "raster",
      "tiles": [
        "https://tile.waymarkedtrails.org/hiking/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "attribution": "<a href=\"https://waymarkedtrails.org\">© Waymarked Trails</a>"
    },
    "terrain-source": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256,
      "attribution": "<a href=\"https://aws.amazon.com/public-datasets/terrain/\">AWS Terrarium 3D</a>"
    }
  },
  "terrain": {
    "source": "terrain-source",
    "exaggeration": 2.0
  },
  "layers": [
    {
      "id": "opentopomap-layer",
      "type": "raster",
      "source": "opentopomap",
      "paint": {
        "raster-opacity": 1.0
      }
    },
    {
      "id": "hiking-layer",
      "type": "raster",
      "source": "hiking",
      "paint": {
        "raster-opacity": 0.85
      }
    }
  ]
}
